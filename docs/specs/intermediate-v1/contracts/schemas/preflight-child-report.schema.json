{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preflight-child-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "backend_status",
    "device_available",
    "versions",
    "error_text",
    "cuda"
  ],
  "properties": {
    "format": {
      "const": "llm-foundations-preflight-child-v1"
    },
    "backend_status": {
      "enum": [
        "passed",
        "missing",
        "version_mismatch"
      ]
    },
    "device_available": {
      "type": "boolean"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torch",
        "transformers",
        "peft",
        "accelerate",
        "safetensors"
      ],
      "properties": {
        "torch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "transformers": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "peft": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "accelerate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "safetensors": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "error_text": {
      "type": "string",
      "maxLength": 2000
    },
    "cuda": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "reason_code",
            "device"
          ],
          "properties": {
            "result": {
              "enum": [
                "passed",
                "failed"
              ]
            },
            "reason_code": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "CUDA_DEVICE_NOT_FOUND",
                    "CUDA_CAPABILITY_UNSUPPORTED",
                    "CUDA_ARCH_NOT_IN_BUILD",
                    "CUDA_MEMORY_INSUFFICIENT",
                    "CUDA_NUMERIC_CHECK_FAILED"
                  ]
                }
              ]
            },
            "device": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "count",
                    "compute_capability",
                    "arch_list",
                    "total_memory_mib",
                    "free_memory_mib",
                    "max_relative_difference"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "compute_capability": {
                      "type": "string",
                      "pattern": "^[0-9]{1,2}\\.[0-9]$"
                    },
                    "arch_list": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "pattern": "^(sm|compute)_[0-9]{2,3}[a-z]?$"
                      }
                    },
                    "total_memory_mib": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "free_memory_mib": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_relative_difference": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "passed"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "type": "null"
                  },
                  "device": {
                    "type": "object",
                    "properties": {
                      "max_relative_difference": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "reason_code": {
                    "enum": [
                      "CUDA_DEVICE_NOT_FOUND",
                      "CUDA_CAPABILITY_UNSUPPORTED",
                      "CUDA_ARCH_NOT_IN_BUILD",
                      "CUDA_MEMORY_INSUFFICIENT",
                      "CUDA_NUMERIC_CHECK_FAILED"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
