{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "revision",
    "requirement_id",
    "claim_status",
    "verification_status",
    "review_status",
    "artifact_ids",
    "created_at",
    "origin",
    "note_snapshots",
    "intermediate_evidence_packet_complete",
    "verification_checks",
    "completion_status",
    "latest_decision"
  ],
  "properties": {
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "requirement_id": {
      "enum": [
        "CUR-004",
        "FOUNDATION-12",
        "CUR-005",
        "CUR-006",
        "CUR-007",
        "CUR-008",
        "CUR-009",
        "CUR-010",
        "CUR-011",
        "CUR-012",
        "CUR-014",
        "CUR-015"
      ]
    },
    "claim_status": {
      "enum": [
        "local_submission",
        "imported_claim"
      ]
    },
    "verification_status": {
      "enum": [
        "unverified",
        "artifact_verified"
      ]
    },
    "review_status": {
      "enum": [
        "not_reviewed",
        "self_reviewed",
        "independently_reviewed"
      ]
    },
    "claim_text": {
      "type": "string",
      "maxLength": 20000
    },
    "artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "check_ids",
        "artifact_sha256s"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_sha256s": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "assessment_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "legacy_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed",
        "note",
        "source_format"
      ],
      "properties": {
        "reviewed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 20000
        },
        "source_format": {
          "const": "llm-foundations-progress-v1"
        }
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "structured_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "citations"
      ],
      "properties": {
        "format": {
          "const": "retrieval-citation-submission-v1"
        },
        "citations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": false,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "record_id",
                "span_start_utf8",
                "span_end_utf8"
              ],
              "properties": {
                "query_id": {
                  "const": "RQ01"
                },
                "record_id": {
                  "enum": [
                    "RM01",
                    "RM02",
                    "RM03",
                    "RM04",
                    "RM05",
                    "RM06",
                    "RM07",
                    "RM08"
                  ]
                },
                "span_start_utf8": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "span_end_utf8": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "record_id",
                "span_start_utf8",
                "span_end_utf8"
              ],
              "properties": {
                "query_id": {
                  "const": "RQ02"
                },
                "record_id": {
                  "enum": [
                    "RM01",
                    "RM02",
                    "RM03",
                    "RM04",
                    "RM05",
                    "RM06",
                    "RM07",
                    "RM08"
                  ]
                },
                "span_start_utf8": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "span_end_utf8": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "record_id",
                "span_start_utf8",
                "span_end_utf8"
              ],
              "properties": {
                "query_id": {
                  "const": "RQ03"
                },
                "record_id": {
                  "enum": [
                    "RM01",
                    "RM02",
                    "RM03",
                    "RM04",
                    "RM05",
                    "RM06",
                    "RM07",
                    "RM08"
                  ]
                },
                "span_start_utf8": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "span_end_utf8": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "record_id",
                "span_start_utf8",
                "span_end_utf8"
              ],
              "properties": {
                "query_id": {
                  "const": "RQ04"
                },
                "record_id": {
                  "enum": [
                    "RM01",
                    "RM02",
                    "RM03",
                    "RM04",
                    "RM05",
                    "RM06",
                    "RM07",
                    "RM08"
                  ]
                },
                "span_start_utf8": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "span_end_utf8": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "record_id",
                "span_start_utf8",
                "span_end_utf8"
              ],
              "properties": {
                "query_id": {
                  "const": "RQ05"
                },
                "record_id": {
                  "enum": [
                    "RM01",
                    "RM02",
                    "RM03",
                    "RM04",
                    "RM05",
                    "RM06",
                    "RM07",
                    "RM08"
                  ]
                },
                "span_start_utf8": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "span_end_utf8": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "record_id",
                "span_start_utf8",
                "span_end_utf8"
              ],
              "properties": {
                "query_id": {
                  "const": "RQ06"
                },
                "record_id": {
                  "enum": [
                    "RM01",
                    "RM02",
                    "RM03",
                    "RM04",
                    "RM05",
                    "RM06",
                    "RM07",
                    "RM08"
                  ]
                },
                "span_start_utf8": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10485760
                },
                "span_end_utf8": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              }
            }
          ]
        }
      }
    },
    "note_snapshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note_id",
          "revision",
          "sha256",
          "content"
        ],
        "properties": {
          "note_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "content": {
            "$ref": "notebook-entry.schema.json"
          }
        }
      }
    },
    "intermediate_evidence_packet_complete": {
      "type": "boolean",
      "readOnly": true
    },
    "verification_checks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "received_value",
          "expected_rule",
          "artifact_ids"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "received_value": {
            "type": "string",
            "maxLength": 2000
          },
          "expected_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "artifact_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      }
    },
    "completion_status": {
      "enum": [
        "not_complete",
        "packet_complete_not_assessed",
        "packet_complete_not_meeting",
        "completed_self_reviewed",
        "completed_independently_reviewed"
      ],
      "description": "Read-only; derived for CUR-012 only (all other records: not_complete) from packet completeness and the latest local assessment."
    },
    "latest_decision": {
      "oneOf": [
        {
          "enum": [
            "meets",
            "partially_meets",
            "does_not_meet"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requirement_id": {
            "const": "CUR-015"
          }
        }
      },
      "then": {
        "required": [
          "structured_response"
        ]
      },
      "else": {
        "not": {
          "required": [
            "structured_response"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "intermediate_evidence_packet_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "requirement_id": {
            "const": "CUR-012"
          },
          "verification_status": {
            "const": "artifact_verified"
          },
          "claim_status": {
            "const": "local_submission"
          }
        }
      }
    }
  ]
}
