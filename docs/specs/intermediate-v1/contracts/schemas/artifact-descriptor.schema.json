{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"artifact-descriptor.schema.json","type":"object","additionalProperties":false,"required":["artifact_id","type","display_name","relative_path","size_bytes","sha256","created_at","media_type","preview_policy","origin","job_id"],"properties":{"artifact_id":{"$ref":"common.schema.json#/$defs/id"},"type":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"display_name":{"type":"string","minLength":1,"maxLength":120},"relative_path":{"type":"string","pattern":"^objects/[0-9a-f]{2}/[0-9a-f]{64}/[A-Za-z0-9._-]{1,120}$"},"size_bytes":{"type":"integer","minimum":0,"maximum":2147483648},"sha256":{"$ref":"common.schema.json#/$defs/sha256"},"created_at":{"$ref":"common.schema.json#/$defs/time"},"media_type":{"type":"string","minLength":1,"maxLength":120},"preview_policy":{"enum":["text","metadata_only","download_only"]},"origin":{"$ref":"common.schema.json#/$defs/origin"},"job_id":{"oneOf":[{"$ref":"common.schema.json#/$defs/id"},{"type":"null"}],"description":"Creating job; null only for upload, backup and control-channel registrations."}}}
