{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"dataset-manifest.schema.json","type":"object","additionalProperties":false,"required":["format","dataset_id","name","record_format","origin","splits","audit_artifact_id","created_at","manifest_sha256","eligibility"],"properties":{"format":{"const":"llm-foundations-dataset-v1"},"dataset_id":{"$ref":"common.schema.json#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":120},"record_format":{"enum":["document_text_v1","instruction_intent_v1","retrieval_v1"]},"origin":{"$ref":"common.schema.json#/$defs/origin"},"splits":{"type":"object","minProperties":1,"maxProperties":3,"propertyNames":{"enum":["train","validation","test"]},"additionalProperties":{"type":"object","additionalProperties":false,"required":["artifact_id","sha256","records","utf8_bytes","sealed"],"properties":{"artifact_id":{"$ref":"common.schema.json#/$defs/id"},"sha256":{"$ref":"common.schema.json#/$defs/sha256"},"records":{"type":"integer","minimum":1,"maximum":100000},"utf8_bytes":{"type":"integer","minimum":1,"maximum":10485760},"sealed":{"type":"boolean","description":"True only when the split's bytes match a sealed entry of the shipped release registry."}}}},"audit_artifact_id":{"$ref":"common.schema.json#/$defs/id"},"created_at":{"$ref":"common.schema.json#/$defs/time"},"provenance_note":{"type":"string","maxLength":20000},"manifest_sha256":{"$ref":"common.schema.json#/$defs/sha256","description":"SHA-256 of INT-008 canonical bytes of {record_format, splits:{<split>:{sha256, records, utf8_bytes, sealed}}}; content-only, so identical uploads share it."},"eligibility":{"enum":["eligible","audit_only"]}}}
