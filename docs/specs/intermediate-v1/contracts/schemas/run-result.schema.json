{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"run-result.schema.json","type":"object","additionalProperties":false,"required":["run_id","status","last_observed_step","last_durable_checkpoint_step","finished_at"],"properties":{"run_id":{"$ref":"common.schema.json#/$defs/id"},"status":{"enum":["completed","failed","interrupted"]},"requested_final_step":{"type":"integer","minimum":0,"maximum":2147483647},"final_step":{"type":"integer","minimum":0,"maximum":2147483647},"last_observed_step":{"type":"integer","minimum":0,"maximum":2147483647},"last_durable_checkpoint_step":{"oneOf":[{"type":"integer","minimum":0,"maximum":2147483647},{"type":"null"}]},"error":{"type":"string","maxLength":4000},"finished_at":{"$ref":"common.schema.json#/$defs/time"}},"allOf":[{"if":{"properties":{"status":{"const":"completed"}}},"then":{"required":["requested_final_step","final_step"]}}],"description":"Stored terminal summary of a run (not an API response): status = Job.state, last_observed_step = Job.step, last_durable_checkpoint_step = Job.checkpoint_boundary.step or null."}
