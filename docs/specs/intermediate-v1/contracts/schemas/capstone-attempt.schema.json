{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"capstone-attempt.schema.json","type":"object","additionalProperties":false,
 "required":["attempt_id","reason","baseline_subject","candidate_subject","dataset_id","dataset_manifest_sha256","evaluation_profile_id","prior_release_count","token_sha256","token_state","test_exposure","created_at"],
 "properties":{"attempt_id":{"$ref":"common.schema.json#/$defs/id"},"reason":{"enum":["first_attempt","prior_failed","prior_cancelled","new_experiment"]},"baseline_subject":{"$ref":"#/$defs/baseSubject"},"candidate_subject":{"$ref":"#/$defs/adapterSubject"},"dataset_id":{"$ref":"common.schema.json#/$defs/id"},"dataset_manifest_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"evaluation_profile_id":{"const":"applied-intents-greedy-v1"},"prior_release_count":{"type":"integer","minimum":0,"maximum":99},"token_sha256":{"$ref":"common.schema.json#/$defs/sha256"},"token_state":{"enum":["available","consumed"]},"test_exposure":{"enum":["fresh_test","reused_test"]},"prior_attempt_id":{"$ref":"common.schema.json#/$defs/id"},"created_at":{"$ref":"common.schema.json#/$defs/time"},"consumed_at":{"$ref":"common.schema.json#/$defs/time"},"job_id":{"$ref":"common.schema.json#/$defs/id"},"evaluation_id":{"$ref":"common.schema.json#/$defs/id"}},
