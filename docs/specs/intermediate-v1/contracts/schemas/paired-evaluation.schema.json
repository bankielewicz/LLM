{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paired-evaluation.schema.json",
  "title": "Paired sealed evaluation artifact (baseline then candidate over identical ordered records)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "evaluation_id",
    "job_id",
    "attempt_id",
    "dataset_id",
    "dataset_manifest_sha256",
    "evaluation_profile_id",
    "ordered_record_ids",
    "subjects",
    "deltas"
  ],
  "properties": {
    "format": {
      "const": "llm-foundations-paired-evaluation-v1"
    },
    "evaluation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "attempt_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "dataset_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "evaluation_profile_id": {
      "const": "applied-intents-greedy-v1"
    },
    "ordered_record_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_index",
          "subject_identity_sha256",
          "records_artifact_id",
          "exact_intent_match",
          "response_schema_valid_rate"
        ],
        "properties": {
          "subject_index": {
            "enum": [
              0,
              1
            ]
          },
          "subject_identity_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "records_artifact_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "exact_intent_match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator",
              "ratio"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              },
              "ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "response_schema_valid_rate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "numerator",
              "denominator",
              "ratio"
            ],
            "properties": {
              "numerator": {
                "type": "integer",
                "minimum": 0
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              },
              "ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_intent_match",
        "response_schema_valid_rate"
      ],
      "properties": {
        "exact_intent_match": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "response_schema_valid_rate": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    }
  }
}
