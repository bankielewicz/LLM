{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-artifact.schema.json",
  "title": "Generation artifact written by generate and chat_generate (single field list for RUN-012, DAT-006 and APP-013)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "job_id",
    "run_id",
    "backend",
    "subject",
    "subject_identity_sha256",
    "preview_artifact_id",
    "context_preview_digest",
    "input",
    "serialized_input",
    "input_token_ids",
    "input_token_count",
    "original_input_token_count",
    "dropped_message_indices",
    "cropped_input_tokens",
    "effective_context_budget",
    "decoding",
    "output_token_ids",
    "generated_token_count",
    "text",
    "stop_reason",
    "utf8_replacement_occurred",
    "conversation",
    "retrieval",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "format": {
      "const": "llm-foundations-generation-v1"
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "backend": {
      "enum": [
        "tiny",
        "chat"
      ]
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkpoint_id"
          ],
          "properties": {
            "checkpoint_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id"
          ],
          "properties": {
            "model_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "adapter_checkpoint_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      ]
    },
    "subject_identity_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "preview_artifact_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "context_preview_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "messages"
          ],
          "properties": {
            "messages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "content"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "system",
                      "user",
                      "assistant"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                }
              }
            }
          }
        }
      ]
    },
    "serialized_input": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "input_token_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "input_token_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "original_input_token_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "dropped_message_indices": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "cropped_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "effective_context_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_new_tokens",
        "temperature",
        "top_p",
        "seed"
      ],
      "properties": {
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "output_token_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "generated_token_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 512
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "stop_reason": {
      "enum": [
        "eos",
        "length",
        "cancelled"
      ]
    },
    "utf8_replacement_occurred": {
      "type": "boolean"
    },
    "conversation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversation_id",
            "expected_conversation_revision"
          ],
          "properties": {
            "conversation_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "expected_conversation_revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "retrieval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retrieval_artifact_id",
            "hits",
            "augmented_prompt_sha256"
          ],
          "properties": {
            "retrieval_artifact_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "hits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "rank",
                  "score"
                ],
                "properties": {
                  "record_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "augmented_prompt_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "ended_at": {
      "$ref": "common.schema.json#/$defs/time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "const": "tiny"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "properties": {
          "subject": {
            "required": [
              "checkpoint_id"
            ]
          },
          "input": {
            "required": [
              "prompt"
            ]
          },
          "conversation": {
            "type": "null"
          },
          "retrieval": {
            "type": "null"
          },
          "dropped_message_indices": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backend": {
            "const": "chat"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "properties": {
          "subject": {
            "required": [
              "model_id"
            ]
          },
          "input": {
            "required": [
              "messages"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decoding": {
            "properties": {
              "temperature": {
                "const": 0
              }
            },
            "required": [
              "temperature"
            ]
          }
        },
        "required": [
          "decoding"
        ]
      },
      "then": {
        "properties": {
          "decoding": {
            "properties": {
              "top_p": {
                "const": 1
              }
            }
          }
        }
      }
    }
  ]
}
