{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"data-audit.schema.json","type":"object","additionalProperties":false,"required":["format","dataset_id","eligibility","record_count","utf8_bytes","split_counts","exact_duplicate_pairs","normalized_near_duplicate_pairs","group_overlap_count","checked_at","algorithm_version","rejections"],"properties":{"format":{"const":"llm-foundations-data-audit-v1"},"dataset_id":{"$ref":"common.schema.json#/$defs/id"},"eligibility":{"enum":["eligible","audit_only"]},"record_count":{"type":"integer","minimum":0,"maximum":100000},"utf8_bytes":{"type":"integer","minimum":0,"maximum":31457280,"description":"Sum of strict UTF-8 lengths of record text fields (document_text_v1/retrieval_v1: text; instruction_intent_v1: every message content plus expected.response); excludes JSON framing."},"split_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"slice_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"exact_duplicate_pairs":{"type":"integer","minimum":0},"normalized_near_duplicate_pairs":{"type":"integer","minimum":0},"group_overlap_count":{"type":"integer","minimum":0},"rejections":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"enum":["cross_split_exact_duplicate","cross_split_normalized_near_duplicate","group_overlap"]},"description":"Leakage kinds found; empty exactly when eligible."},"checked_at":{"$ref":"common.schema.json#/$defs/time"},"algorithm_version":{"const":"data-audit-v2"}}}
